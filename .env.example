# Copy this file to `.env` and fill in the values you have.
# All variables are optional — the platform degrades gracefully when a key is missing.
# Prefix: every setting is read from an environment variable named MIP_<FIELD>.

# --- Core ---
MIP_ENVIRONMENT=development
MIP_DATABASE_URL=sqlite:///data/market_intel.db
MIP_LOG_LEVEL=INFO
MIP_LOG_DIR=logs

# --- Provider selection (swappable adapters) ---
# "chain" tries yfinance -> FRED -> Alpha Vantage so one source breaking
# degrades the data instead of emptying it. Pin a single adapter by name
# ("yfinance", "fred", "alphavantage") if you want one source only.
MIP_MARKET_DATA_PROVIDER=chain
MIP_NEWS_PROVIDER=yfinance

# --- API keys ---
# Anthropic (AI research summaries): https://console.anthropic.com/
MIP_ANTHROPIC_API_KEY=

# Finnhub (fundamentals, earnings calendar): https://finnhub.io/
MIP_FINNHUB_API_KEY=

# NewsAPI (financial news): https://newsapi.org/
MIP_NEWSAPI_API_KEY=

# FRED (macroeconomic series): https://fred.stlouisfed.org/docs/api/
# Optional -- without a key the adapter uses the keyless public CSV endpoint.
MIP_FRED_API_KEY=

# Alpha Vantage (daily bars fallback): https://www.alphavantage.co/support/#api-key
# Free tier allows 25 requests/day, so this sits last in the provider chain.
MIP_ALPHAVANTAGE_API_KEY=
MIP_ALPHAVANTAGE_DAILY_BUDGET=25

# --- Caching (minutes) ---
MIP_PRICE_CACHE_TTL_MINUTES=15
MIP_NEWS_CACHE_TTL_MINUTES=30
MIP_SECURITY_INFO_CACHE_TTL_MINUTES=1440
MIP_FUNDAMENTALS_CACHE_TTL_MINUTES=360
MIP_OPTIONS_CACHE_TTL_MINUTES=30

# --- Market data ---
# Default lookback when no start date is given.
MIP_DEFAULT_HISTORY_DAYS=365

# --- AI research ---
MIP_AI_MODEL=claude-opus-5
MIP_AI_MAX_TOKENS=16000

# --- Global recap ---
# Web searches one agentic market wrap may run while researching the news.
MIP_RECAP_WEB_SEARCH_MAX_USES=12

# --- MKR 14-Framework (single-name analysis) ---
# Daily history loaded per ticker. Three years covers the 200-day average and
# leaves the monthly timeframe enough bars to trend.
MIP_MKR_HISTORY_DAYS=1100
MIP_MKR_HORIZON_DAYS=90
MIP_MKR_MONTE_CARLO_PATHS=1000
# Risk-free rate for Black-Scholes deltas and option repricing. Only feeds the
# greeks, so a slightly stale rate moves deltas in the third decimal.
MIP_MKR_RISK_FREE_RATE=0.04
MIP_MKR_WEB_SEARCH_MAX_USES=8
